
<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/auth.css">
</head>

<body>
    <%- include('../includes/nav.ejs') %>

    <main>

        <% if (errorMessage) { %>
            <div class="auth-alert error-alert" id="authAlert">
                <div class="alert-icon">!</div>

                <div class="alert-content">
                    <h4>Signup unsuccessful</h4>
                    <p><%= errorMessage %></p>
                </div>

                <button type="button" class="alert-close" onclick="closeAuthAlert()">
                    &times;
                </button>

                <div class="alert-progress"></div>
            </div>
        <% } %>

      

        <form class="login-form" action="/signup" method="POST" novalidate>

            <div class="form-control">
                <label for="name">Full Name</label>
                <input type="text" name="name" id="name" value="<%= oldInput.name %>" required>

                <label for="userName">Username</label>
                <input type="text" name="userName" id="userName" value="<%= oldInput.userName %>" required>

                <label for="email">E-Mail</label>
                <input type="email" name="email" id="email" value="<%= oldInput.email %>" required>

                <label for="phoneNumber">Phone Number</label>
                <input type="tel" name="phoneNumber" id="phoneNumber" value="<%= oldInput.phoneNumber %>" required>
            </div>

            <div class="form-control">
                <label for="password">Password</label>
                <input type="password" name="password" id="password" value="<%= oldInput.password %>" required>
            </div>

            <div class="form-control">
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" name="confirmPassword" id="confirmPassword" value="<%= oldInput.confirmPassword %>" required>
            </div>

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <button class="btn" type="submit">Signup</button>
        </form>

        <p>Already have an account? <a href="/login">Sign in</a></p>

    </main>

    <script>
        const alertBox = document.getElementById('authAlert');

        function closeAuthAlert() {
            if (!alertBox) return;

            alertBox.classList.add('hide');

            setTimeout(() => {
                alertBox.remove();
            }, 300);
        }

        if (alertBox) {
            setTimeout(closeAuthAlert, 5000);
        }

        const signupForm = document.querySelector('.login-form');
        const password = document.getElementById('password');
        const confirmPassword = document.getElementById('confirmPassword');

        signupForm.addEventListener('submit', function (event) {
            if (password.value !== confirmPassword.value) {
                event.preventDefault();
                alert('Passwords do not match.');
                confirmPassword.focus();
            }
        });
    </script>

    <%- include('../includes/end.ejs') %>

