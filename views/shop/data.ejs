 
<%- include('../includes/head.ejs') %>
 <style>
        .data-page {
            width: min(1100px, 92%);
            margin: 45px auto;
        }

        .data-header {
            background: linear-gradient(120deg, #102c27, #176b50);
            color: #fff;
            padding: 35px;
            border-radius: 18px;
            margin-bottom: 30px;
        }

        .data-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            color: #a7f3d0;
        }

        .data-header h1 {
            font-size: 32px;
            margin: 12px 0 8px;
        }

        .data-header p {
            color: #d1fae5;
            margin: 0;
        }

        .data-content {
            background: #fff;
            padding: 25px;
            border-radius: 16px;
        }

        .data-filter {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .data-filter label {
            font-weight: 600;
            color: #26352e;
        }

        .data-filter select {
            padding: 11px 15px;
            border: 1px solid #dce5df;
            border-radius: 9px;
            outline: none;
            background: #fff;
            min-width: 160px;
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
        }

        .plan-card {
            border: 1px solid #e5ece7;
            border-radius: 13px;
            padding: 20px;
            transition: .2s ease;
        }

        .plan-card:hover {
            border-color: #168052;
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, .06);
        }

        .plan-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
        }

        .network-name {
            font-weight: 700;
            color: #176b50;
        }

        .plan-type {
            background: #e9f8ef;
            color: #176b50;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .plan-card h2 {
            font-size: 19px;
            color: #1c2b23;
            margin: 0 0 20px;
        }

        .plan-details {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            color: #718078;
            font-size: 13px;
            padding-bottom: 17px;
            border-bottom: 1px solid #edf1ee;
        }

        .plan-details strong {
            color: #34463b;
        }

        .plan-bottom {
            padding-top: 17px;
        }

        .plan-price {
            color: #176b50;
            font-size: 23px;
        }

        .empty-plans {
            text-align: center;
            padding: 55px 15px;
            color: #68766e;
        }

        .empty-plans h3 {
            color: #26352e;
        }

        @media (max-width: 600px) {
            .data-page {
                margin: 25px auto;
            }

            .data-header {
                padding: 25px 20px;
            }

            .data-header h1 {
                font-size: 26px;
            }

            .data-content {
                padding: 17px;
            }

            .data-filter {
                align-items: flex-start;
                flex-direction: column;
            }

            .data-filter select {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <%- include('../includes/nav.ejs') %>

    <main class="data-page">
        <section class="data-header">
            <div>
                <span class="data-label">DATA SERVICES</span>
                <h1>Buy Data</h1>
                <p>Select a data plan that suits your needs.</p>
            </div>
        </section>

        <section class="data-content">
            <div class="data-filter">
                <label for="networkFilter">Filter by network</label>
                <select id="networkFilter">
                    <option value="all">All networks</option>
                    <option value="MTN">MTN</option>
                    <option value="AIRTEL">Airtel</option>
                    <option value="GLO">Glo</option>
                    <option value="9MOBILE">9mobile</option>
                </select>
            </div>

            <% if (!plans || plans.length === 0) { %>
                <div class="empty-plans">
                    <h3>No data plans available</h3>
                    <p>Data plans could not be loaded right now. Please try again later.</p>
                </div>
            <% } else { %>
                <div class="plans-grid" id="plansGrid">
                    <% plans.forEach(plan => { %>
                        <article class="plan-card"
                            data-network="<%= String(plan.network || plan.network_name || '').toUpperCase() %>">

                            <div class="plan-top">
                                <span class="network-name">
                                    <%= plan.network || plan.network_name || 'Network' %>
                                </span>
                                <span class="plan-type">
                                    <%= plan.plan_type || 'Data' %>
                                </span>
                            </div>

                            <h2><%= plan.plan_name || plan.name || 'Data Plan' %></h2>

                            <div class="plan-details">
                                <span>Validity</span>
                                <strong><%= plan.plan_day || plan.validity || 'Not specified' %></strong>
                            </div>

                            <div class="plan-bottom">
                                <strong class="plan-price">
                                    ₦<%= Number(plan.amount || plan.price || 0).toLocaleString('en-NG') %>
                                </strong>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>

    <script>
        const networkFilter = document.getElementById('networkFilter');
        const planCards = document.querySelectorAll('.plan-card');

        networkFilter.addEventListener('change', () => {
            const selectedNetwork = networkFilter.value;

            planCards.forEach(card => {
                const network = card.dataset.network;

                card.style.display =
                    selectedNetwork === 'all' || network.includes(selectedNetwork)
                        ? ''
                        : 'none';
            });
        });
    </script>

    <%- include('../includes/end.ejs') %>