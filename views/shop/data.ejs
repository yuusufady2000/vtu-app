
<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/dash.css">

<style>
.data-page {
    max-width: 1050px;
    margin: 35px auto;
    padding: 20px;
}

.data-header {
    margin-bottom: 25px;
}

.data-header h2 {
    font-size: 25px;
    margin-bottom: 8px;
}

.data-header p {
    color: #777;
    margin: 0;
}

.data-filter-box {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    background: #fff;
    padding: 22px;
    border-radius: 12px;
    margin-bottom: 25px;
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
}

.data-field label {
    display: block;
    font-weight: 600;
    margin-bottom: 9px;
}

.data-field select,
.data-field input {
    width: 100%;
    padding: 13px;
    border: 1px solid #ddd;
    border-radius: 8px;
    outline: none;
    background: #fff;
}

.data-field select:focus,
.data-field input:focus {
    border-color: #087f5b;
}

.data-plans-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
}

.data-plans-heading h3 {
    font-size: 19px;
    margin: 0;
}

.data-plans-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

.data-plan-card {
    background: #fff;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid #eee;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    transition: 0.2s;
}

.data-plan-card.selected {
    border: 2px solid #087f5b;
}

.data-plan-size {
    font-size: 23px;
    font-weight: 700;
    margin-bottom: 8px;
}

.data-plan-type {
    display: inline-block;
    padding: 5px 10px;
    background: #e8f5ef;
    color: #087f5b;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 13px;
}

.data-plan-details {
    color: #777;
    font-size: 13px;
    margin-bottom: 12px;
}

.data-plan-price {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 15px;
}

.data-plan-button {
    width: 100%;
    border: none;
    border-radius: 8px;
    padding: 12px;
    background: #087f5b;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
}

.data-plan-button:hover {
    background: #066b4c;
}

.data-plan-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.data-message {
    padding: 14px;
    border-radius: 8px;
    margin-bottom: 18px;
    display: none;
}

.data-message.error {
    display: block;
    background: #fff0f0;
    color: #c62828;
}

.data-message.info {
    display: block;
    background: #eef6ff;
    color: #175a9c;
}

.data-empty {
    background: #fff;
    padding: 35px 20px;
    border-radius: 12px;
    text-align: center;
    color: #777;
    grid-column: 1 / -1;
}

.data-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
    z-index: 9999;
}

.data-modal.show {
    display: flex;
}

.data-modal-content {
    width: 100%;
    max-width: 430px;
    background: #fff;
    padding: 25px;
    border-radius: 14px;
}

.data-modal-content h3 {
    margin: 0 0 8px;
    font-size: 21px;
}

.data-modal-content p {
    color: #777;
    font-size: 14px;
    margin-bottom: 20px;
}

.data-modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.data-modal-actions button {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
}

.data-cancel {
    background: #eee;
    color: #333;
}

.data-confirm {
    background: #087f5b;
    color: #fff;
}

.data-close {
    width: 100%;
    margin-top: 15px;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #087f5b;
    color: #fff;
    cursor: pointer;
    font-weight: 600;
    display: none;
}

.data-modal-details {
    background: #f7f8fa;
    border-radius: 9px;
    padding: 14px;
    font-size: 14px;
}

.data-modal-details div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 8px 0;
}

.data-modal-details strong {
    text-align: right;
}

@media (max-width: 750px) {
    .data-plans-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 520px) {
    .data-page {
        padding: 12px;
        margin: 20px auto;
    }

    .data-filter-box {
        grid-template-columns: 1fr;
        padding: 16px;
    }

    .data-plans-grid {
        grid-template-columns: 1fr;
    }
}
</style>

</head>

<body>
<%- include('../includes/nav.ejs') %>

<main class="data-page">

    <div class="data-header">
        <h2>Buy Data</h2>
        <p>Select your network, choose a data plan and enter the recipient's phone number.</p>
    </div>

    <div id="data-message" class="data-message"></div>

    <div class="data-filter-box">

        <div class="data-field">
            <label for="network">Select Network</label>
            <select id="network">
                <option value="">Choose network</option>
                <option value="MTN">MTN</option>
                <option value="Airtel">Airtel</option>
                <option value="Glo">Glo</option>
                <option value="9mobile">9mobile</option>
            </select>
        </div>

        <div class="data-field">
            <label for="plan-type">Select Plan Type</label>
            <select id="plan-type">
                <option value="">All plan types</option>
                <option value="SME">SME</option>
                <option value="Corporate">Corporate</option>
                <option value="Gifting">Gifting</option>
            </select>
        </div>

    </div>

    <div class="data-plans-heading">
        <h3>Available Data Plans</h3>
        <span id="plan-count">0 plans</span>
    </div>

    <div id="data-plans" class="data-plans-grid">
        <div class="data-empty">Select a network to view available plans.</div>
    </div>

</main>

<div class="data-modal" id="purchase-modal">
    <div class="data-modal-content">

        <h3 id="modal-title">Confirm Data Purchase</h3>
        <p id="modal-description">Confirm the details before continuing.</p>

        <div id="purchase-details" class="data-modal-details">

            <div>
                <span>Network</span>
                <strong id="detail-network">-</strong>
            </div>

            <div>
                <span>Data Plan</span>
                <strong id="detail-plan">-</strong>
            </div>

            <div>
                <span>Price</span>
                <strong id="detail-price">-</strong>
            </div>

            <div>
                <span>Phone Number</span>
                <strong id="detail-phone">-</strong>
            </div>

        </div>

        <div class="data-field" id="phone-field" style="margin-top:18px;">
            <label for="phone">Recipient Phone Number</label>
            <input
                type="tel"
                id="phone"
                maxlength="11"
                inputmode="numeric"
                placeholder="08012345678"
                autocomplete="tel"
            >
        </div>

        <div class="data-modal-actions" id="confirm-actions">
            <button type="button" class="data-cancel" id="cancel-purchase">
                Cancel
            </button>

            <button type="button" class="data-confirm" id="confirm-purchase">
                Confirm Purchase
            </button>
        </div>

        <button type="button" class="data-close" id="close-modal">
            Close
        </button>

    </div>
</div>

<script>
const csrfToken = '<%= csrfToken %>';

const networkSelect = document.getElementById('network');
const typeSelect = document.getElementById('plan-type');
const plansContainer = document.getElementById('data-plans');
const planCount = document.getElementById('plan-count');
const messageBox = document.getElementById('data-message');

const purchaseModal = document.getElementById('purchase-modal');
const modalTitle = document.getElementById('modal-title');
const modalDescription = document.getElementById('modal-description');
const phoneInput = document.getElementById('phone');

const confirmButton = document.getElementById('confirm-purchase');
const cancelButton = document.getElementById('cancel-purchase');
const closeButton = document.getElementById('close-modal');

const confirmActions = document.getElementById('confirm-actions');
const phoneField = document.getElementById('phone-field');

let selectedPlan = null;
let loadingPlans = false;
let purchasing = false;

const formatPrice = (price) => {
    const amount = Number(price);

    if (!Number.isFinite(amount)) {
        return 'Price unavailable';
    }

    return new Intl.NumberFormat('en-NG', {
        style: 'currency',
        currency: 'NGN'
    }).format(amount);
};

const showMessage = (message, type = 'error') => {
    messageBox.textContent = message;
    messageBox.className = `data-message ${type}`;
};

const clearMessage = () => {
    messageBox.textContent = '';
    messageBox.className = 'data-message';
};

const getErrorMessage = (result) => {
    if (result?.message) {
        return result.message;
    }

    return 'Something went wrong. Please try again.';
};

const renderPlans = (plans) => {
    plansContainer.replaceChildren();
    planCount.textContent = `${plans.length} plans`;

    if (!plans.length) {
        const empty = document.createElement('div');
        empty.className = 'data-empty';
        empty.textContent = 'No plans found for this selection.';
        plansContainer.appendChild(empty);
        return;
    }

    plans.forEach(plan => {
        const card = document.createElement('div');
        card.className = 'data-plan-card';

        const size = document.createElement('div');
        size.className = 'data-plan-size';
        size.textContent = plan.datasize || 'Data plan';

        const type = document.createElement('span');
        type.className = 'data-plan-type';
        type.textContent = plan.type || 'Data';

        const details = document.createElement('div');
        details.className = 'data-plan-details';
        details.textContent = `${plan.network || ''} • ${plan.day || 'N/A'} days`;

        const price = document.createElement('div');
        price.className = 'data-plan-price';
        price.textContent = formatPrice(plan.price);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'data-plan-button';
        button.textContent = 'Buy Now';

        button.addEventListener('click', () => {
            selectedPlan = plan;

            document.querySelectorAll('.data-plan-card').forEach(item => {
                item.classList.remove('selected');
            });

            card.classList.add('selected');

            document.getElementById('detail-network').textContent = plan.network || '';
            document.getElementById('detail-plan').textContent =
                `${plan.datasize || ''} (${plan.type || ''})`;
            document.getElementById('detail-price').textContent = formatPrice(plan.price);
            document.getElementById('detail-phone').textContent = 'Enter below';

            phoneInput.value = '';
            modalTitle.textContent = 'Confirm Data Purchase';
            modalDescription.textContent = 'Enter the recipient phone number and confirm your purchase.';

            phoneField.style.display = 'block';
            confirmActions.style.display = 'flex';
            closeButton.style.display = 'none';
            purchaseModal.classList.add('show');
        });

        card.append(size, type, details, price, button);
        plansContainer.appendChild(card);
    });
};

const fetchPlans = async () => {
    const network = networkSelect.value;
    const type = typeSelect.value;

    clearMessage();

    if (!network) {
        plansContainer.replaceChildren();

        const empty = document.createElement('div');
        empty.className = 'data-empty';
        empty.textContent = 'Select a network to view available plans.';

        plansContainer.appendChild(empty);
        planCount.textContent = '0 plans';
        return;
    }

    if (loadingPlans) return;

    loadingPlans = true;

    plansContainer.replaceChildren();

    const loading = document.createElement('div');
    loading.className = 'data-empty';
    loading.textContent = 'Loading data plans...';

    plansContainer.appendChild(loading);

    try {
        const response = await fetch('/fetch-data-plans', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': csrfToken
            },
            body: JSON.stringify({
                network,
                type,
                _csrf: csrfToken
            })
        });

        const result = await response.json();

        if (!response.ok || !result.status) {
            throw new Error(getErrorMessage(result));
        }

        renderPlans(Array.isArray(result.data) ? result.data : []);

    } catch (error) {
        plansContainer.replaceChildren();

        const empty = document.createElement('div');
        empty.className = 'data-empty';
        empty.textContent = error.message || 'Unable to load data plans.';

        plansContainer.appendChild(empty);
        planCount.textContent = '0 plans';

        showMessage(error.message || 'Unable to load data plans.');
    } finally {
        loadingPlans = false;
    }
};

const closePurchaseModal = () => {
    if (purchasing) return;

    purchaseModal.classList.remove('show');
    selectedPlan = null;
};

const resetModal = () => {
    modalTitle.textContent = 'Confirm Data Purchase';
    modalDescription.textContent = 'Confirm the details before continuing.';
    phoneField.style.display = 'block';
    confirmActions.style.display = 'flex';
    closeButton.style.display = 'none';
};

const submitPurchase = async () => {
    if (purchasing || !selectedPlan) return;

    const phone = phoneInput.value.trim();

    if (!/^0\d{10}$/.test(phone)) {
        showMessage('Enter a valid 11-digit phone number.');
        phoneInput.focus();
        return;
    }

    if (!selectedPlan.plan_id) {
        showMessage('The selected plan does not have a valid plan ID.');
        return;
    }

    const network = networkSelect.value;

    if (!network) {
        showMessage('Please select a network.');
        return;
    }

    const confirmed = window.confirm(
        `Buy ${selectedPlan.datasize} for ${phone} at ${formatPrice(selectedPlan.price)}?`
    );

    if (!confirmed) return;

    purchasing = true;
    confirmButton.disabled = true;
    confirmButton.textContent = 'Processing...';
    clearMessage();

    try {
        const response = await fetch('/purchase-data', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': csrfToken
            },
            body: JSON.stringify({
                phone,
                network,
                planId: selectedPlan.plan_id,
                _csrf: csrfToken
            })
        });

        const result = await response.json();

        if (!response.ok || !result.status) {
            throw new Error(getErrorMessage(result));
        }

        const transactionStatus = result.transactionStatus;

        phoneField.style.display = 'none';
        confirmActions.style.display = 'none';
        closeButton.style.display = 'block';

        if (transactionStatus === 'success') {
            modalTitle.textContent = 'Purchase Successful';
            modalDescription.textContent =
                result.message || 'Your data purchase was successful.';
        } else {
            modalTitle.textContent = 'Purchase Pending';
            modalDescription.textContent =
                result.message || 'Your purchase is being processed. Check your transaction status before trying again.';
        }

        document.getElementById('detail-phone').textContent = phone;

    } catch (error) {
        showMessage(error.message || 'Unable to process your purchase.');
    } finally {
        purchasing = false;
        confirmButton.disabled = false;
        confirmButton.textContent = 'Confirm Purchase';
    }
};

networkSelect.addEventListener('change', fetchPlans);
typeSelect.addEventListener('change', fetchPlans);

confirmButton.addEventListener('click', submitPurchase);
cancelButton.addEventListener('click', closePurchaseModal);
closeButton.addEventListener('click', closePurchaseModal);

purchaseModal.addEventListener('click', (event) => {
    if (event.target === purchaseModal) {
        closePurchaseModal();
    }
});
</script>

<%- include('../includes/end.ejs') %>
