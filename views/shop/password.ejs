
<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/auth.css">
</head>

<body>
    <%- include('../includes/nav.ejs') %>

    <main class="auth-container">

        <% if (errorMessage) { %>
            <div class="auth-alert" id="authAlert">
                <div class="alert-icon">!</div>

                <div class="alert-content">
                    <h4>Login unsuccessful</h4>
                    <p><%= errorMessage %></p>
                </div>

                <button
                    type="button"
                    class="alert-close"
                    onclick="closeAuthAlert()"
                    aria-label="Close alert"
                >
                    &times;
                </button>

                <div class="alert-progress"></div>
            </div>
        <% } %>

        <section class="auth-card">

            <div class="auth-icon">
                <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="5" width="18" height="14" rx="3"
                        stroke="currentColor" stroke-width="1.7"/>
                    <path d="M4 7L12 13L20 7"
                        stroke="currentColor" stroke-width="1.7"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>

            <span class="auth-brand">ZEAL DATA</span>

            <h1>Welcome back</h1>

            <p class="auth-description">
                Enter your email address to receive a secure reset link.
            </p>

            <form class="login-form" action="/forgot-password" method="POST">

                <div class="form-control">
                    <label for="email">Email address</label>

                    <div class="input-wrapper">
                        

                        <input
                            type="email"
                            name="email"
                            id="email"
                            placeholder="example@email.com"
                            autocomplete="email"
                            required
                        >
                    </div>
                </div>

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >

                <button class="btn login-btn" type="submit">
                    <span>Send reset link</span>
                </button>

            </form>

            <div class="auth-footer">
                <span>Secure access powered by</span>
                <strong>Zeal Data</strong>
            </div>

        </section>

    </main>

    <script>
        const alertBox = document.getElementById('authAlert');

        function closeAuthAlert() {
            if (!alertBox) return;

            alertBox.classList.add('hide');

            setTimeout(() => {
                alertBox.remove();
            }, 300);
        }

        if (alertBox) {
            setTimeout(closeAuthAlert, 5000);
        }
    </script>

    <%- include('../includes/end.ejs') %>
